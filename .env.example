# Copy to .env and fill in.  .env is gitignored.

# ---- LLM APIs (debate judge + pi_agent) ----
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
GOOGLE_API_KEY=...                 # for Gemini 2.5 Pro via AI Studio

# ---- Embeddings ----
# OpenAI key above also covers text-embedding-3
VOYAGE_API_KEY=                    # optional, for Voyage-3-large baseline

# ---- HuggingFace (for MedCPT, BGE-M3, MedGemma, Prometheus-2) ----
HF_TOKEN=hf_...
HF_HOME=./.cache/huggingface

# ---- Datasets (PhysioNet for MIMIC, if used later) ----
PHYSIONET_USER=
PHYSIONET_PASS=

# ---- Compute ----
CUDA_VISIBLE_DEVICES=0
TORCH_HOME=./.cache/torch

# ---- Caching / determinism ----
GLOBAL_SEED=42
